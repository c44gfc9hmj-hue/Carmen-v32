{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carmen-iphone-v25",
  "main": "Carmen-V33-worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/search",
      "/chat",
      "/analyze",
      "/synthesize"
    ]
  },
  "observability": {
    "enabled": true
  }
}
